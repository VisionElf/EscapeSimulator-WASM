<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>EscapeSimulator.Telemetry</AssemblyName>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildThisFileDirectory)..\.deps\BepInEx-5.4.23.5\BepInEx\core</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Escape Simulator_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Escape Simulator_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Set GameDir to your Escape Simulator installation directory." />
    <Error Condition="!Exists('$(GameDir)\Escape Simulator_Data\Managed\UnityEngine.CoreModule.dll')" Text="Unity game references were not found under GameDir." />
    <Error Condition="!Exists('$(BepInExDir)\BepInEx.dll')" Text="Provide BepInEx 5.4.23.5 in .deps/BepInEx-5.4.23.5 or set BepInExDir to its core directory." />
  </Target>
</Project>
